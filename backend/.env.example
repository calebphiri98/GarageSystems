# Copy these values into your hosting provider's environment settings.
# Never commit real credentials.

# ---- Database (Neon PostgreSQL) ----
DB_HOST=ep-xxxxxx-pooler.region.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASS=replace_me
DB_SSLMODE=require
# Only needed by older libpq clients (e.g. XAMPP on Windows). The value is the
# endpoint id, i.e. the part of DB_HOST before "-pooler". Leave blank elsewhere.
DB_ENDPOINT=

# ---- Auth ----
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRY_HOURS=12

# ---- URLs / CORS ----
# Comma-separated list of exact frontend origins (no trailing slash).
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
# Used for payment return links.
FRONTEND_URL=https://your-frontend.vercel.app

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Email (Brevo API) ----
BREVO_API_KEY=
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=Uptown Garage

# ---- Payments (PayChangu) ----
PAYCHANGU_SECRET_KEY=
PAYCHANGU_WEBHOOK_SECRET=

# ---- Misc ----
DEFAULT_JOB_DURATION_HOURS=2
# Optional CA bundle path. On Linux hosts leave this unset to use the system
# trust store. If set, it must be a readable path inside the container.
CURL_CA_BUNDLE=
