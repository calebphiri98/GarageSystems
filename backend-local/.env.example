# Local XAMPP MySQL backend configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=uptown_garage_local
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Use a long random string; it signs login tokens.
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRY_HOURS=12

# Vite dev server origin(s)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost
FRONTEND_URL=http://localhost:5173

DEFAULT_JOB_DURATION_HOURS=2

# Optional integrations - leave blank to disable locally.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Uptown Garage

# Set to true to run the local checkout simulator (no real money moves).
PAYMENTS_MOCK=false
PAYCHANGU_SECRET_KEY=
PAYCHANGU_WEBHOOK_SECRET=

CURL_CA_BUNDLE=
BREVO_API_KEY=
