# Normalize line endings so deployment scripts work in Linux containers.
* text=auto

# Shell scripts must keep LF endings or Linux reports "bad interpreter".
*.sh text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf

# Source and data files
*.php text eol=lf
*.sql text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
